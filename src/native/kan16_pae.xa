; kan16_pae.xa - 16 GB PAE bank-window variant of the native NaN16 core.
; Separate from src/native/kan16.xa (the legacy non-PAE product kernel).
; 32-bit PAE, 2 MB pages, 1 GB bank window at linear 0x40200000
; (guest word 0x8000000; bank 0 itself starts at G = 0x200000).
; Guest words keep the MEMMAP direct map: word = (physical - G)/8, so E820
; holes stay holes.
; PMEM v1 is written at guest word 0x3F800 before the guest entry PC.
; The shared PMEM constants are expanded from src/lib/memmap_defs.nas by
; tools/pae16_asm.sh before nasm1 sees this file (nasm1 has no .include).
.base 0x10000
.code32
.include "../lib/memmap_defs.nas"
.equ MASK 0x3FFFFF
.equ MAXOP 0x45
.equ G 0x200000
.equ R 0x8000
.equ VGA 0xB8000
.equ FB 0xA0000
.equ VMODE 0x8066
.equ FBW 0x8068
.equ FBH 0x806C
.equ FLAGM 0x8040
.equ STEPS 0x8044
.equ MAXS 0x8048
.equ T0 0x804C
.equ KB 0x8050
.equ OB 0x8054
.equ MS 0x8058
.equ MSF 0x805C
.equ SHIFT 0x8060
.equ E0 0x8061
.equ CAPS 0x8062
.equ RHEAD 0x8064
.equ RTAIL 0x8065
.equ KRING 0x8070
.equ FBBASE 0x8090
.equ FBTOT 0x8094
.equ VBEARG 0x8098
.equ RAWKB 0x809C
.equ CPUIDR 0x80B0
.equ IDT 0x9000
.equ MASKV 0x80C0
.equ PAEF 0x80C4
.equ CURB 0x80C8
.equ NFR 0x80CC
.equ NSW 0x80D0
.equ NWD 0x80D4
.equ MAXM 0x80D8
.equ BS 0x80DC
.equ BD 0x80E0
.equ BTOT 0x80E4
.equ BC 0x80E8
.equ BDIR 0x80EC
.equ BN 0x80F0
.equ BO 0x80F4
.equ PDPT 0x40000
.equ PDA 0x41000
.equ FT 0x50000
.equ BOUNCE 0x60000
.equ E8N 0x5FC
.equ E8T 0x600
.equ MAXF 0x2400          ; frame slots: 9216 * 2 MiB = 18 GiB address span
.equ MAXW 0x80F8          ; highest usable guest word end (scratch dword)
.equ MM_SCR0 0x8100       ; PMEM builder scratch
.equ MM_SCR1 0x8104
.equ MM_SCR2 0x8108
.equ MM_SCR3 0x810C
_start:
  CLD
  MOVL $0x7FFFFFFF,[MAXS]
  MOVL $1,[FLAGM]
  MOVL $0,[STEPS]
  MOVL $0xA0000,[FBBASE]
  MOVL $64000,[FBTOT]
  MOVB $0,[RAWKB]
  MOV $G,%EDI
  XOR %EAX,%EAX
  MOV $0x800000,%ECX
  REPSTOSD
  MOV $0x20000,%ESI
  MOV $G,%EDI
  MOV $0x20000,%ECX
  REPMOVSD
  CALL @hw_init
  CALL @pae_init
  CALL @memmap_build
  XOR %ESI,%ESI
loop:
  MOV [STEPS],%EAX
  CMP [MAXS],%EAX
  JAE @done
  INC %EAX
  MOV %EAX,[STEPS]
  MOV %ESI,%ECX
  AND [MASKV],%ECX
  CMP $0x8000000,%ECX
  JB @fk0
  CALL @nrmC
fk0:
  CALL @nib
  JC @gate
  INC %ESI
  SHRD $16,%EDX,%EAX
  MOV %EAX,%EBX
  SHR $24,%EBX
  CMP $0xFF,%EBX
  JE @done
  CMP $MAXOP,%EBX
  JA @badop
  MOV %EAX,%EBP
  SHR $18,%EBP
  AND $0x3C,%EBP
  MOV %EAX,%ECX
  SHR $14,%ECX
  AND $0x3C,%ECX
  MOV [R+ECX],%ECX
  MOV %EAX,%EDX
  AND $15,%EDX
  MOV [R+EDX*4],%EDX
  TEST %EBX,%EBX
  JZ @L5
  TEST %EDI,[FLAGM]
  JZ @loop
L5:
  JMP [tbl+EBX*4]
head:
  MOV %EBX,%ECX
  AND $0x7FF0,%ECX
  CMP $0x7FF0,%ECX
  JNE @L8
  MOV $0x01020000,%ECX
  BT %EBX,%ECX
  JNC @L8
  MOV %EBX,%ECX
  SHR $2,%ECX
  AND $2,%ECX
  SHR $15,%EBX
  OR %EBX,%ECX
  CLC
  RET
L8:
  STC
  RET
nib:
  MOV [G+ECX*8],%EAX
  MOV [G+4+ECX*8],%EDX
  MOV %EDX,%EBX
  SHR $16,%EBX
  CALL @head
  JC @L9
  LEA [ECX*4],%EDI
  MOV %EAX,%EBX
  BSWAP %EBX
  SHR $16,%EBX
  CALL @head
  JC @L9
  OR %ECX,%EDI
L9:
  RET
putw:
  MOV %ECX,%EDX
  AND $3,%ECX
  MOVZWL [heads+ECX*2],%ECX
  ROL $8,%CX
  PUSH %EBX
  SHL $16,%EBX
  OR %ECX,%EBX
  MOV %EBX,[G+EAX*8]
  POP %EBX
  SHR $16,%EBX
  SHR $2,%EDX
  MOVZWL [heads+EDX*2],%EDX
  SHL $16,%EDX
  OR %EDX,%EBX
  MOV %EBX,[G+4+EAX*8]
  RET
wrz:
  MOV %EBX,[R+EBP]
  TEST %EBX,%EBX
wf:
  MOV %EBX,[R+EBP]
fl:
  SETC %CL
  SETZ %AL
fl2:
  MOVZX %CL,%ECX
  MOVZX %AL,%EAX
  LEA [ECX+EAX*2],%ECX
  MOV $1,%EAX
  SHL %CL,%EAX
  MOV %EAX,[FLAGM]
  JMP @loop
st:
  MOV %EBX,[R+EBP]
  JMP @loop
stf:
  MOV %EBX,[R+EBP]
  MOVL $1,[FLAGM]
  JMP @loop
h_bool:
  XOR %EBX,%EBX
  MOV %ECX,%EAX
  OR %EDX,%EAX
  NOT %EAX
  TEST $1,%EDI
  JZ @hb1
  OR %EAX,%EBX
hb1:
  MOV %ECX,%EAX
  NOT %EAX
  AND %EDX,%EAX
  TEST $2,%EDI
  JZ @hb2
  OR %EAX,%EBX
hb2:
  MOV %EDX,%EAX
  NOT %EAX
  AND %ECX,%EAX
  TEST $4,%EDI
  JZ @hb3
  OR %EAX,%EBX
hb3:
  MOV %ECX,%EAX
  AND %EDX,%EAX
  TEST $8,%EDI
  JZ @hb4
  OR %EAX,%EBX
hb4:
  JMP @wrz
h_movi:
  MOVZWL %AX,%EBX
  JMP @st
h_movhi:
  MOVZWL [R+EBP],%EBX
  SHL $16,%EAX
  OR %EAX,%EBX
  JMP @st
h_add:
  MOV %ECX,%EBX
  ADD %EDX,%EBX
  JMP @wf
h_sub:
  MOV %ECX,%EBX
  SUB %EDX,%EBX
  JMP @wf
h_shl:
  MOV %ECX,%EBX
  MOV %EAX,%ECX
  SHL %CL,%EBX
  JMP @wrz
h_shr:
  MOV %ECX,%EBX
  MOV %EAX,%ECX
  SHR %CL,%EBX
  JMP @wrz
h_sar:
  MOV %ECX,%EBX
  MOV %EAX,%ECX
  SAR %CL,%EBX
  JMP @wrz
h_cmp:
  CMP %EDX,%ECX
  JMP @fl
h_cmps:
  CMP %EDX,%ECX
  SETZ %AL
  SETL %CL
  JMP @fl2
h_ld:
  MOVZWL %AX,%EAX
  ADD %ECX,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk1
  CALL @nrmA
fk1:
  MOV [G+2+EAX*8],%EBX
  JMP @st
h_st:
  MOVZWL %AX,%EAX
  ADD %ECX,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk2
  CALL @nrmA
fk2:
  MOV [R+EBP],%EBX
  MOV $10,%ECX
  CALL @putw
  JMP @loop
h_stw:
  MOV %ECX,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk3
  CALL @nrmA
fk3:
  MOV [R+EBP],%EBX
  MOV %EDX,%ECX
  AND $15,%ECX
  CALL @putw
  JMP @loop
h_ldn:
  MOVZWL %AX,%EAX
  ADD %ECX,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk4
  CALL @nrmA
fk4:
  MOV %EAX,%ECX
  CALL @nib
  MOV %EDI,%EBX
  JNC @st
  OR $-1,%EBX
  JMP @st
h_jmp:
  MOVZWL %AX,%ESI
  JMP @loop
h_call:
  MOV %ESI,[R+60]
  MOVZWL %AX,%ESI
  JMP @loop
h_ret:
  MOV [R+60],%ESI
  JMP @loop
h_jmpf:
  AND $0xFFFFFF,%EAX
  MOV %EAX,%ESI
  JMP @loop
h_callf:
  MOV %ESI,[R+60]
  AND $0xFFFFFF,%EAX
  MOV %EAX,%ESI
  JMP @loop
h_jmpr:
  MOV %ECX,%ESI
  JMP @loop
h_callr:
  MOV %ESI,[R+60]
  MOV %ECX,%ESI
  JMP @loop
h_nop:
  JMP @loop
h_vpoke:
  MOVZXB [VMODE],%EAX
  CMP $1,%EAX
  JE @vp_gfx
  CMP $2000,%ECX
  JAE @loop
  MOV [R+EBP],%EBX
  MOV %BX,[VGA+ECX*2]
  JMP @loop
vp_gfx:
  CMP [FBTOT],%ECX
  JAE @loop
  MOV [R+EBP],%EBX
  MOV [FBBASE],%EDI
  ADD %ECX,%EDI
  MOV %BL,[EDI]
  JMP @loop
h_vpeek:
  MOVZXB [VMODE],%EAX
  CMP $1,%EAX
  JE @vpk_gfx
  CMP $2000,%ECX
  JAE @loop
  MOVZWL [VGA+ECX*2],%EBX
  JMP @st
vpk_gfx:
  CMP [FBTOT],%ECX
  JAE @loop
  MOV [FBBASE],%EDI
  ADD %ECX,%EDI
  MOVZXB [EDI],%EBX
  JMP @st
h_bswapm:
  MOVZWL %AX,%EAX
  ADD %ECX,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk5
  CALL @nrmA
fk5:
  MOV [G+EAX*8],%ECX
  MOV [G+4+EAX*8],%EDX
  BSWAP %ECX
  BSWAP %EDX
  MOV %EDX,[G+EAX*8]
  MOV %ECX,[G+4+EAX*8]
  JMP @loop
h_putc:
  MOV [R+EBP],%EBX
  MOV %BL,[OB]
  CALL @out1
  JMP @loop
out1:
  MOV $0x3FD,%EDX
oL1:
  IN %DX,%AL
  TEST $0x20,%AL
  JZ @oL1
  MOV $0x3F8,%EDX
  MOVZXB [OB],%EAX
  OUT %AL,%DX
  RET
h_dispq:
  MOVZXB [VMODE],%EAX
  CMP $1,%EAX
  JNE @dq_text
  MOV $0x1300C800,%EBX
  JMP @st
dq_text:
  MOV $0x31950,%EBX
  JMP @st
h_dispset:
  MOV [R+EBP],%EAX
  CMP $0xFFFF0000,%EAX
  JAE @sd_raw
  CMP $0x10000,%EAX
  JAE @sd_vbe
  AND $255,%EAX
  CMP $0x13,%EAX
  JE @sd13
  CALL @vbe_off
  XOR %EBX,%EBX
  MOV %BL,[VMODE]
  MOV $0xA0000,%EBX
  MOV %EBX,[FBBASE]
  MOV $80,%EBX
  MOV %EBX,[FBW]
  MOV $25,%EBX
  MOV %EBX,[FBH]
  XOR %EAX,%EAX
  MOV $1000,%ECX
  MOV $VGA,%EDI
  CLD
  REPSTOSD
  JMP @loop
sd13:
  CALL @vbe_off
  MOV $1,%EBX
  MOV %BL,[VMODE]
  MOV $0xA0000,%EBX
  MOV %EBX,[FBBASE]
  MOV $64000,%EBX
  MOV %EBX,[FBTOT]
  MOV $320,%EBX
  MOV %EBX,[FBW]
  MOV $200,%EBX
  MOV %EBX,[FBH]
  XOR %EAX,%EAX
  MOV $16000,%ECX
  MOV $FB,%EDI
  CLD
  REPSTOSD
  JMP @loop
sd_raw:
  MOVZXB %AL,%EAX
  MOV %AL,[RAWKB]
  MOVB $0,[RHEAD]
  MOVB $0,[RTAIL]
  JMP @loop
sd_vbe:
  MOV %EAX,[VBEARG]
  MOV $4,%EBX
  XOR %EAX,%EAX
  CALL @dispi
  MOV $3,%EBX
  MOV $8,%EAX
  CALL @dispi
  MOV $1,%EBX
  MOV [VBEARG],%EAX
  SHR $16,%EAX
  CALL @dispi
  MOV $2,%EBX
  MOV [VBEARG],%EAX
  AND $0xFFFF,%EAX
  CALL @dispi
  MOV $4,%EBX
  MOV $0x41,%EAX
  CALL @dispi
  MOV $0xE0000000,%EBX
  XOR %ECX,%ECX
pci_l:
  MOV %ECX,%EAX
  SHL $11,%EAX
  OR $0x80000008,%EAX
  MOV %EAX,%EDI
  MOV $0xCF8,%EDX
  OUT %EAX,%DX
  MOV $0xCFC,%EDX
  IN %DX,%EAX
  SHR $16,%EAX
  CMP $0x300,%EAX
  JNE @pci_n
  MOV %EDI,%EAX
  ADD $8,%EAX
  MOV $0xCF8,%EDX
  OUT %EAX,%DX
  MOV $0xCFC,%EDX
  IN %DX,%EAX
  AND $0xFFFFFFF0,%EAX
  JZ @pci_x
  MOV %EAX,%EBX
  JMP @pci_x
pci_n:
  INC %ECX
  CMP $32,%ECX
  JB @pci_l
pci_x:
  MOV %EBX,[FBBASE]
  MOV $1,%EBX
  MOV %BL,[VMODE]
  MOV [VBEARG],%EAX
  SHR $16,%EAX
  MOV %EAX,[FBW]
  MOV [VBEARG],%EBX
  AND $0xFFFF,%EBX
  MOV %EBX,[FBH]
  IMUL %EAX,%EBX
  MOV %EBX,[FBTOT]
  MOV %EBX,%ECX
  SHR $2,%ECX
  MOV [FBBASE],%EDI
  XOR %EAX,%EAX
  CLD
  REPSTOSD
  JMP @loop
vbe_off:
  MOV [FBBASE],%EAX
  CMP $0xA0000,%EAX
  JE @vo_ret
  MOV $4,%EBX
  XOR %EAX,%EAX
  CALL @dispi
vo_ret:
  RET
dispi:
  PUSH %EAX
  MOV $0x1CE,%EDX
  MOV %EBX,%EAX
  .byte 0x66
  OUT %AX,%DX
  POP %EAX
  MOV $0x1CF,%EDX
  .byte 0x66
  OUT %AX,%DX
  RET
h_fbinfo:
  MOV [FBW],%EBX
  SHL $16,%EBX
  MOV [FBH],%EAX
  OR %EAX,%EBX
  JMP @st
h_vsync:
  MOVZXB [VMODE],%EAX
  CMP $1,%EAX
  JNE @loop
  MOV $0x3DA,%DX
vs1:
  IN %DX,%AL
  TEST $8,%AL
  JZ @vs1
vs2:
  IN %DX,%AL
  TEST $8,%AL
  JNZ @vs2
  JMP @loop
h_fbcopy:
  MOV %ECX,%EAX
  MOV %EDX,%EBX
  MOV [R+EBP],%ECX
  JECXZ @loop
  PUSH %ESI
  MOV [FBBASE],%ESI
  ADD %EBX,%ESI
  MOV [FBBASE],%EDI
  ADD %EAX,%EDI
  MOV %ECX,%EBX
  SHR $2,%ECX
  CLD
  REPMOVSD
  MOV %EBX,%ECX
  AND $3,%ECX
  .byte 0xF3,0xA4
  POP %ESI
  JMP @loop
h_fbfill:
  MOV %ECX,%EDI
  MOV [R+EBP],%ECX
  MOV %EDX,%EAX
  AND $255,%EAX
  MOV %EAX,%EBX
  SHL $8,%EBX
  OR %EBX,%EAX
  MOV %EAX,%EBX
  SHL $16,%EBX
  OR %EBX,%EAX
  ADD [FBBASE],%EDI
  MOV %ECX,%EBX
  SHR $2,%ECX
  CLD
  REPSTOSD
  MOV %EBX,%ECX
  AND $3,%ECX
  .byte 0xF3,0xAA
  JMP @loop
h_cpuid:
  MOV %ECX,%EAX
  MOV %EDX,%EDI
  AND $3,%EDI
  MOV %EAX,%EBX
  SHR $16,%EBX
  CMP $0x4E4D,%EBX
  JE @memq
  PUSH %ESI
  XOR %ECX,%ECX
  .byte 0x0F,0xA2
  MOV %EAX,[CPUIDR]
  MOV %EBX,[CPUIDR+4]
  MOV %ECX,[CPUIDR+8]
  MOV %EDX,[CPUIDR+12]
  MOV [CPUIDR+EDI*4],%EBX
  POP %ESI
  JMP @st
h_rdtsc:
  .byte 0x0F,0x31
  MOV %EAX,%EBX
  TEST %ECX,%ECX
  JZ @st
  MOV %EDX,%EBX
  JMP @st
h_outb:
  MOV [R+EBP],%EAX
  MOV %ECX,%EDX
  AND $0xFFFF,%EDX
  OUT %AL,%DX
  JMP @loop
h_inb:
  MOV %ECX,%EDX
  AND $0xFFFF,%EDX
  IN %DX,%AL
  XOR %EBX,%EBX
  MOV %AL,%BL
  JMP @st
h_outw:
  MOV [R+EBP],%EAX
  AND $0xFFFF,%EAX
  MOV %ECX,%EDX
  AND $0xFFFF,%EDX
  .byte 0x66
  OUT %AX,%DX
  JMP @loop
h_inw:
  MOV %ECX,%EDX
  AND $0xFFFF,%EDX
  .byte 0x66
  IN %DX,%AX
  XOR %EBX,%EBX
  MOV %AX,%BX
  JMP @st
h_outsw:
  PUSH %ESI
  MOV %ECX,%EDI
  MOV %EDX,%EBX
  AND $0x7FFFFFF,%EBX
  SHL $3,%EBX
  ADD $G,%EBX
  ADD $2,%EBX
  MOV [R+EBP],%ECX
  JECXZ @osw_done
osw_l:
  MOVZWL [EBX],%EAX
  MOV %EDI,%EDX
  .byte 0x66
  OUT %AX,%DX
  ADD $8,%EBX
  DEC %ECX
  JNZ @osw_l
osw_done:
  POP %ESI
  JMP @loop
h_outl:
  MOV [R+EBP],%EAX
  MOV %ECX,%EDX
  AND $0xFFFF,%EDX
  OUT %EAX,%DX
  JMP @loop
h_mul:
  MOV %ECX,%EBX
  IMUL %EDX,%EBX
  JMP @wrz
h_mulh:
  MOV %ECX,%EAX
  IMUL %EDX
  MOV %EDX,%EBX
  JMP @wrz
h_mulhu:
  MOV %ECX,%EAX
  MUL %EDX
  MOV %EDX,%EBX
  JMP @wrz
h_div:
  TEST %EDX,%EDX
  JZ @z0
  CMP $-1,%EDX
  JNE @dv1
  MOV %ECX,%EBX
  NEG %EBX
  JMP @wrz
dv1:
  MOV %EDX,%EBX
  MOV %ECX,%EAX
  CLTD
  IDIV %EBX
  MOV %EAX,%EBX
  JMP @wrz
h_mod:
  TEST %EDX,%EDX
  JZ @zx
  CMP $-1,%EDX
  JNE @md1
  XOR %EBX,%EBX
  JMP @wrz
md1:
  MOV %EDX,%EBX
  MOV %ECX,%EAX
  CLTD
  IDIV %EBX
  MOV %EDX,%EBX
  JMP @wrz
h_divu:
  TEST %EDX,%EDX
  JZ @z0
  MOV %EDX,%EBX
  MOV %ECX,%EAX
  XOR %EDX,%EDX
  DIV %EBX
  MOV %EAX,%EBX
  JMP @wrz
h_modu:
  TEST %EDX,%EDX
  JZ @zx
  MOV %EDX,%EBX
  MOV %ECX,%EAX
  XOR %EDX,%EDX
  DIV %EBX
  MOV %EDX,%EBX
  JMP @wrz
z0:
  XOR %EBX,%EBX
  JMP @zf
zx:
  MOV %ECX,%EBX
zf:
  MOV %EBX,[R+EBP]
  MOVL $8,[FLAGM]
  JMP @loop
h_addi:
  MOVSXW %AX,%EBX
  ADD %ECX,%EBX
  JMP @wf
h_ldb:
  MOVZWL %AX,%EAX
  ADD %ECX,%EAX
  MOV %EAX,%ECX
  SHR $2,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk6
  CALL @nrmA
fk6:
  MOV [G+2+EAX*8],%EBX
  SHL $3,%ECX
  SHR %CL,%EBX
  MOVZX %BL,%EBX
  JMP @st
h_stb:
  MOVZWL %AX,%EAX
  ADD %ECX,%EAX
  MOV %EAX,%ECX
  SHL $3,%ECX
  SHR $2,%EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk7
  CALL @nrmA
fk7:
  MOV [G+2+EAX*8],%EBX
  MOV $255,%EDX
  SHL %CL,%EDX
  NOT %EDX
  AND %EDX,%EBX
  MOVZXB [R+EBP],%EDX
  SHL %CL,%EDX
  OR %EDX,%EBX
  MOV $10,%ECX
  CALL @putw
  JMP @loop
h_bcopy:
  MOV %ECX,%EAX
  AND [MASKV],%EAX
  MOV [R+EBP],%EBX
  AND [MASKV],%EBX
  MOV %EDX,%ECX
  JECXZ @bc3
  MOV [MASKV],%EDI
  CMP $0x8000000,%EDI
  JB @bcf
  MOV $0x8000000,%EDI
  SUB %EAX,%EDI
  JB @bcslow
  CMP %ECX,%EDI
  JB @bcslow
  MOV $0x8000000,%EDI
  SUB %EBX,%EDI
  JB @bcslow
  CMP %ECX,%EDI
  JB @bcslow
bcf:
  MOV %EBX,%EDI
  SUB %EAX,%EDI
  AND [MASKV],%EDI
  CMP %ECX,%EDI
  JB @bc2
bc1:
  MOVQ [G+EAX*8],%XMM0
  MOVQ %XMM0,[G+EBX*8]
  INC %EAX
  AND [MASKV],%EAX
  INC %EBX
  AND [MASKV],%EBX
  LOOP @bc1
bc3:
  JMP @loop
bc2:
  LEA [-1+EAX+ECX],%EAX
  AND [MASKV],%EAX
  LEA [-1+EBX+ECX],%EBX
  AND [MASKV],%EBX
bc4:
  MOVQ [G+EAX*8],%XMM0
  MOVQ %XMM0,[G+EBX*8]
  DEC %EAX
  AND [MASKV],%EAX
  DEC %EBX
  AND [MASKV],%EBX
  LOOP @bc4
  JMP @loop
h_bfill:
  MOV %ECX,[T0]
  MOV %EDX,%EDI
  MOV [R+EBP],%EAX
bf1:
  TEST %EDI,%EDI
  JZ @loop
  PUSH %EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @fk8
  CALL @nrmA
fk8:
  MOV [T0],%EBX
  MOV $10,%ECX
  CALL @putw
  POP %EAX
  INC %EAX
  DEC %EDI
  JMP @bf1
h_fadd:
  MOVD %ECX,%XMM0
  MOVD %EDX,%XMM1
  ADDSS %XMM1,%XMM0
  JMP @fres
h_fsub:
  MOVD %ECX,%XMM0
  MOVD %EDX,%XMM1
