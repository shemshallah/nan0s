tbl:
  .long @h_bool,@h_movi,@h_movhi,@h_add,@h_sub,@h_shl,@h_shr,@h_cmp,@h_ld,@h_st,@h_jmp,@h_call,@h_ret,@h_jmpr,@badop,@h_nop
  .long @h_vpoke,@h_vpeek,@h_key,@h_tick,@h_bswapm,@h_putc,@h_stw,@h_ldn,@h_dispq,@h_dispset,@h_keyq,@h_nop,@badop,@badop,@badop,@badop
  .long @h_mul,@h_mulh,@h_mulhu,@h_div,@h_mod,@h_divu,@h_modu,@h_sar,@h_cmps,@h_addi,@h_ldb,@h_stb,@h_callr,@h_bcopy,@h_bfill,@h_nop
  .long @h_fadd,@h_fsub,@h_fmul,@h_fdiv,@h_fsqrt,@h_fcmp,@h_cvtif,@h_cvtfi,@h_jmpf,@h_callf
  .long @h_fbinfo,@h_vsync,@h_fbcopy,@h_fbfill,@h_outb,@h_inb,@h_inw,@h_outw,@h_outsw,@h_outl,@h_cpuid,@h_rdtsc
; ---- r26e: memory scale. PAE paging (no long mode, IDT unchanged): bank 0 = words 0..2^27-1 mapped at G,
; window W (1 GB at G+1GB) shows bank k (k=word>>27) by rewriting 512 2MB PDEs. Frames come from E820 (boot sector, 0x600).
; Guest sees: CPUID leaf 0x4E4D00nn (nn=0xFF query, 1..31 sets mask 2^nn-1) -> reg0 mask, reg1 words, reg2 flags(b0 PAE, b1 E820), reg3 bank switches.
memq:
  MOV [MASKV],%EDX          ; EDX = current mask (query keeps it)
  MOV %EAX,%EBX
  AND $0xFF,%EBX
  JZ @mq1
  CMP $0x1F,%EBX
  JA @mq1
  ; nn=31 means "give me the whole wrap mask".  On a >16 GiB direct map
  ; the word space crosses bit 31 (the PCI hole), so the literal 2^31-1
  ; would hide the top bank; MAXM is the kernel's power-of-two cap.
  CMP $0x1F,%EBX
  JNE @mq_n31
  MOV [MAXM],%EDX
  JMP @mq0
mq_n31:
  MOV $1,%EDX
  MOV %BL,%CL
  SHL %CL,%EDX
  DEC %EDX
  CMP [MAXM],%EDX
  JBE @mq0
  MOV [MAXM],%EDX           ; cap a too-large request at the real limit
mq0:
  MOV %EDX,[MASKV]
mq1:
  MOV %EDX,[CPUIDR]         ; reg0 = mask
  MOV [NWD],%EAX
  MOV %EAX,[CPUIDR+4]       ; reg1 = words
  MOV [PAEF],%EAX
  MOVZXW [E8N],%EBX
  TEST %EBX,%EBX
  JZ @mq2
  OR $2,%EAX
mq2:
  MOV %EAX,[CPUIDR+8]       ; reg2 = flags (b0 PAE, b1 E820)
  MOV [NSW],%EAX
  MOV %EAX,[CPUIDR+12]      ; reg3 = bank switches
  MOV [CPUIDR+EDI*4],%EBX   ; return CPUIDR[selector]
  JMP @st
nrmA:
  PUSH %ECX
  MOV %EAX,%ECX
  SHR $27,%ECX
  AND $0x7FFFFFF,%EAX
  OR $0x8000000,%EAX
  CMP [CURB],%ECX
  JE @nrmA1
  CALL @bk_sw
nrmA1:
  POP %ECX
  RET
nrmC:
  PUSH %EAX
  MOV %ECX,%EAX
  SHR $27,%EAX
  AND $0x7FFFFFF,%ECX
  OR $0x8000000,%ECX
  CMP [CURB],%EAX
  JE @nrmC1
  PUSH %ECX
  MOV %EAX,%ECX
  CALL @bk_sw
  POP %ECX
nrmC1:
  POP %EAX
  RET
bk_sw:
  PUSH %EAX
  PUSH %EBX
  PUSH %ECX
  PUSH %EDX
  PUSH %EDI
  PUSH %EBP
  MOV %ECX,[CURB]
  MOV [NSW],%EAX
  INC %EAX
  MOV %EAX,[NSW]
  MOV %ECX,%EDX
  SHL $9,%EDX              ; first guest frame of this bank
  ; Guest word 0x8000000 is linear G + 0x40000000 = 0x40200000, i.e. PD1[1].
  ; Write 512 PDEs: PD1[1..511] plus PD2[0] at linear 0x80000000.
  MOV $0x42008,%EDI
  MOV $512,%ECX
bk1:
  CMP $MAXF,%EDX
  JAE @bk2                 ; beyond the frame table: hole
  MOV [FT+EDX*4],%EAX
  TEST %EAX,%EAX
  JZ @bk2                  ; E820 hole: leave the 2 MiB page non-present
  MOV %EAX,%EBP
  SHL $21,%EAX
  OR $0x83,%EAX            ; present, RW, PS, 2 MiB
  MOV %EAX,[EDI]
  SHR $11,%EBP
  MOV %EBP,[EDI+4]
  JMP @bk3
bk2:
  XOR %EAX,%EAX
  MOV %EAX,[EDI]
  MOV %EAX,[EDI+4]
bk3:
  INC %EDX
  ADD $8,%EDI
  DEC %ECX
  JNZ @bk1
  MOV $PDPT,%EAX
  MOV %EAX,%CR3
  POP %EBP
  POP %EDI
  POP %EDX
  POP %ECX
  POP %EBX
  POP %EAX
  RET
bcslow:
  MOV %EAX,[BS]
  MOV %EBX,[BD]
  MOV %ECX,[BTOT]
  XOR %EAX,%EAX
  MOV %EAX,[BC]
  MOV [BD],%EDI
  SUB [BS],%EDI
  AND [MASKV],%EDI
  XOR %EDX,%EDX
  CMP %ECX,%EDI
  JAE @bcsd
  MOV $1,%EDX
bcsd:
  MOV %EDX,[BDIR]
bcsl:
  MOV [BTOT],%EAX
  SUB [BC],%EAX
  JZ @bc3
  MOV $4096,%ECX
  CMP %ECX,%EAX
  JAE @bcn
  MOV %EAX,%ECX
bcn:
  MOV [BC],%EDX
  MOV [BDIR],%EDI
  TEST %EDI,%EDI
  JZ @bco
  MOV %EAX,%EDX
  SUB %ECX,%EDX
bco:
  MOV %ECX,[BN]
  MOV %EDX,[BO]
  MOV [BS],%EAX
  ADD %EDX,%EAX
  XOR %EDX,%EDX
  MOV $BOUNCE,%EDI
bcg:
  PUSH %EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @bcg1
  CALL @nrmA
bcg1:
  MOVQ [G+EAX*8],%XMM0
  POP %EAX
  MOVQ %XMM0,[EDI]
  INC %EAX
  ADD $8,%EDI
  INC %EDX
  CMP %ECX,%EDX
  JB @bcg
  MOV [BD],%EAX
  ADD [BO],%EAX
  XOR %EDX,%EDX
  MOV $BOUNCE,%EDI
bcp:
  PUSH %EAX
  AND [MASKV],%EAX
  CMP $0x8000000,%EAX
  JB @bcp1
  CALL @nrmA
bcp1:
  MOVQ [EDI],%XMM0
  MOVQ %XMM0,[G+EAX*8]
  POP %EAX
  INC %EAX
  ADD $8,%EDI
  INC %EDX
  CMP %ECX,%EDX
  JB @bcp
  MOV [BC],%EAX
  ADD [BN],%EAX
  MOV %EAX,[BC]
  JMP @bcsl
pae_init:
  ; legacy defaults (used when the CPU or firmware has no PAE/E820)
  MOVL $0x3FFFFF,[MASKV]
  MOVL $0x3FFFFF,[MAXM]
  MOVL $0x400000,[NWD]
  MOVL $0,[PAEF]
  MOVL $0xFFFFFFFF,[CURB]
  MOVL $0,[NSW]
  MOVL $0,[NFR]
  ; SSE first: BCOPY uses MOVQ and the guest float ops use MOVD/ADDSS.
  MOV $1,%EAX
  XOR %ECX,%ECX
  .byte 0x0F,0xA2
  MOV %EDX,%EBX            ; CPUID.1:EDX
  MOV %EBX,%EAX
  AND $0x5000000,%EAX      ; FXSR (24) + SSE2 (26)
  CMP $0x5000000,%EAX
  JNE @pa_nosse
  MOV %CR0,%EAX
  AND $0xFFFFFFFB,%EAX     ; CR0.EM = 0
  OR $2,%EAX               ; CR0.MP = 1
  MOV %EAX,%CR0
  .byte 0x0F,0x20,0xE0     ; mov eax,cr4
  OR $0x600,%EAX           ; OSFXSR | OSXMMEXCPT
  .byte 0x0F,0x22,0xE0     ; mov cr4,eax
pa_nosse:
  TEST $0x40,%EBX          ; CPUID.1:EDX.PAE
  JZ @pa_ret
  MOVZXW [E8N],%ECX
  TEST %ECX,%ECX
  JZ @pa_ret
  ; ---- direct frame table: FT[guest_frame] = physical_frame, 0 = hole ----
  ; guest word 0 is physical G = 2 MiB, so guest frame i is physical frame i+1.
  MOV $FT,%EDI
  XOR %EAX,%EAX
  MOV $MAXF,%ECX
  REPSTOSD
  MOV $E8T,%ESI
  MOVZXW [E8N],%ECX
  XOR %EDI,%EDI            ; highest guest frame end
pa_l:
  MOV [ESI+16],%EAX        ; E820 type
  CMP $1,%EAX
  JNE @pa_n
  ; end = start + len (64-bit, no ADC in nasm1)
  MOV [ESI],%EAX           ; start_lo
  MOV [ESI+4],%EBP         ; start_hi
  ADD [ESI+8],%EAX         ; end_lo, CF = carry
  MOV $0,%EBX
  JNC @pa_nc
  MOV $1,%EBX
pa_nc:
  ADD %EBP,%EBX            ; end_hi = start_hi + carry
  ADD [ESI+12],%EBX        ;        + len_hi
  ; start guest frame index -> EDX
  TEST %EBP,%EBP
  JZ @pa_slo
  MOV %EBP,%EDX
  SHL $11,%EDX
  MOV [ESI],%EBP
  SHR $21,%EBP
  OR %EBP,%EDX
  DEC %EDX
  JMP @pa_sdone
pa_slo:
  MOV [ESI],%EDX
  SHR $21,%EDX
  TEST %EDX,%EDX
  JZ @pa_szero
  DEC %EDX
  JMP @pa_sdone
pa_szero:
  XOR %EDX,%EDX
pa_sdone:
  CMP $MAXF,%EDX
  JAE @pa_n
  MOV %EDX,[MM_SCR0]
  ; end guest frame exclusive -> EDX (round a partial 2 MiB frame up)
  MOV %EBX,%EDX
  SHL $11,%EDX
  MOV %EAX,%EBP
  SHR $21,%EBP
  OR %EBP,%EDX
  TEST $0x1FFFFF,%EAX
  JZ @pa_ea
  INC %EDX
pa_ea:
  TEST %EDX,%EDX
  JZ @pa_n
  DEC %EDX
  CMP $MAXF,%EDX
  JBE @pa_ec
  MOV $MAXF,%EDX
pa_ec:
  MOV [MM_SCR0],%EBP
  CMP %EDX,%EBP
  JAE @pa_n
  ; mark [EBP,EDX) usable; frame number = guest index + 1
pa_f:
  LEA [EBP+1],%EAX
  MOV %EAX,[FT+EBP*4]
  INC %EBP
  CMP %EDX,%EBP
  JB @pa_f
  CMP %EDI,%EDX
  JBE @pa_n
  MOV %EDX,%EDI
pa_n:
  ADD $24,%ESI
  DEC %ECX
  JNZ @pa_l
  MOV %EDI,[NFR]
  CMP $16,%EDI
  JB @pa_ret
  MOV %EDI,%EAX
  SHL $18,%EAX             ; words = frames * 2^18
  MOV %EAX,[NWD]
  ; MASKV stays a (2^k)-1 wrap mask like the legacy kernel, but big enough
  ; for every mapped bank.  MEMQ reg1 (NWD) is the exact word count.
  MOV $0x400000,%EDX
pa_p2:
  CMP %EAX,%EDX
  JAE @pa_p3
  CMP $0x80000000,%EDX
  JAE @pa_pcap
  SHL $1,%EDX
  JMP @pa_p2
pa_pcap:
  MOV $0xFFFFFFFF,%EDX
  JMP @pa_p3b
pa_p3:
  DEC %EDX
pa_p3b:
  MOV %EDX,[MAXM]
  ; ---- page tables: PDPT + four PDs, 2 MiB pages ----
  MOV $PDPT,%EDI
  XOR %EAX,%EAX
  MOV $5120,%ECX
  REPSTOSD
  MOV $0x41001,%EAX
  MOV %EAX,[PDPT]
  MOV $0x42001,%EAX
  MOV %EAX,[PDPT+8]
  MOV $0x43001,%EAX
  MOV %EAX,[PDPT+16]
  MOV $0x44001,%EAX
  MOV %EAX,[PDPT+24]
  MOVL $0x83,[PDA]         ; identity 0..2 MiB (kernel, stacks, scratch)
  MOV $0x41008,%EDI        ; PD0[1..511] = bank 0
  XOR %EDX,%EDX
pa_b0:
  CMP $512,%EDX
  JAE @pa_b1
  MOV [FT+EDX*4],%EAX
  TEST %EAX,%EAX
  JZ @pa_b0_hole
  MOV %EAX,%EBX
  SHL $21,%EAX
  OR $0x83,%EAX
  MOV %EAX,[EDI]
  SHR $11,%EBX
  MOV %EBX,[EDI+4]
  JMP @pa_b0_next
pa_b0_hole:
  XOR %EAX,%EAX
  MOV %EAX,[EDI]
  MOV %EAX,[EDI+4]
pa_b0_next:
  ADD $8,%EDI
  INC %EDX
  JMP @pa_b0
pa_b1:
  ; 3..4 GiB identity, uncached, for the VBE LFB / PCI BARs.
  MOV $0x44000,%EDI
  MOV $0xC0000000,%EAX
  MOV $512,%ECX
pa_m:
  MOV %EAX,%EBX
  OR $0x9B,%EBX
  MOV %EBX,[EDI]
  ADD $8,%EDI
  ADD $0x200000,%EAX
  DEC %ECX
  JNZ @pa_m
  ; seed the 1 GiB window with bank 0 before paging is enabled
  XOR %ECX,%ECX
  CALL @bk_sw
  MOVL $0,[NSW]
  .byte 0x0F,0x20,0xE0     ; mov eax,cr4
  OR $0x20,%EAX            ; CR4.PAE
  .byte 0x0F,0x22,0xE0
  MOV $PDPT,%EAX
  MOV %EAX,%CR3
  MOV %CR0,%EAX
  OR $0x80000000,%EAX      ; CR0.PG
  MOV %EAX,%CR0
  MOVL $1,[PAEF]
pa_ret:
  RET

; ---- PMEM v1 producer: E820 -> guest words at 0x3F800 ----
; Same ABI and producer pattern as src/native/kan16.xa memmap_build: direct
; word addresses (physical - G)/8, E820 ranges clipped to [G, G+NWD*8),
; kind = E820 type (1 usable, 2 reserved, 3 ACPI reclaim, 4 ACPI NVS).
memmap_build:
  PUSH %EBX
  PUSH %ECX
  PUSH %EDX
  PUSH %ESI
  PUSH %EDI
  PUSH %EBP
  ; zero the 260-word block (520 dwords)
  MOV $G,%EDI
  MOV $MM_BASE,%EAX
  SHL $3,%EAX
  ADD %EAX,%EDI
  XOR %EAX,%EAX
  MOV $520,%ECX
  REPSTOSD
  ; header: magic, count 0, version, flags (source patched at the end)
  MOV $MM_BASE,%EAX
  MOV $MM_MAGIC,%EBX
  MOV $10,%ECX
  CALL @putw
  MOV $MM_BASE+1,%EAX
  XOR %EBX,%EBX
  MOV $10,%ECX
  CALL @putw
  MOV $MM_BASE+2,%EAX
  MOV $MM_VERSION,%EBX
  MOV $10,%ECX
  CALL @putw
  MOV $MM_BASE+3,%EAX
  MOV $MM_F_E820,%EBX
  MOV $10,%ECX
  CALL @putw
  XOR %EDI,%EDI            ; entry count
  MOVZXW [E8N],%ECX
  TEST %ECX,%ECX
  JZ @mb_synth
  MOV %ECX,[MM_SCR2]       ; E820 count (putw clobbers ECX)
  MOV $E8T,%ESI
mb_loop:
  MOV [ESI+16],%EAX
  CMP $1,%EAX
  JB @mb_next
  CMP $4,%EAX
  JA @mb_next
  CMP $MM_MAX,%EDI
  JAE @mb_next
  MOV %EAX,[MM_SCR3]       ; kind = E820 type
  ; start_word
  MOV [ESI],%EAX
  MOV [ESI+4],%EBP
  TEST %EBP,%EBP
  JZ @mb_slo
  CMP $8,%EBP
  JAE @mb_scap
  ; (start_hi:start_lo - G) >> 3; borrow from the high dword
  SUB $G,%EAX
  JNC @mb_snb
  DEC %EBP
mb_snb:
  SHL $29,%EBP
  SHR $3,%EAX
  OR %EBP,%EAX
  JMP @mb_sdone
mb_slo:
  CMP $G,%EAX
  JBE @mb_szero
  SUB $G,%EAX
  SHR $3,%EAX
  JMP @mb_sdone
mb_szero:
  XOR %EAX,%EAX
  JMP @mb_sdone
mb_scap:
  MOV [NWD],%EAX
mb_sdone:
  MOV %EAX,[MM_SCR0]
  ; end_lo/end_hi = start + len
  MOV [ESI],%EAX
  ADD [ESI+8],%EAX
  MOV $0,%EBX
  JNC @mb_ec
  MOV $1,%EBX
mb_ec:
  ; Memory-first operands are sources here (AT&T-style): EBX becomes
  ; start_hi + carry, then + len_hi, i.e. EBX = end_hi.  [ESI+4] is not written.
  ADD [ESI+4],%EBX
  ADD [ESI+12],%EBX
  TEST %EBX,%EBX
  JZ @mb_elo
  CMP $8,%EBX
  JAE @mb_ecap
  ; (end_hi:end_lo - G) >> 3; borrow from the high dword
  SUB $G,%EAX
  JNC @mb_enb
  DEC %EBX
mb_enb:
  SHL $29,%EBX
  SHR $3,%EAX
  OR %EBX,%EAX
  JMP @mb_edone
mb_elo:
  CMP $G,%EAX
  JBE @mb_ezero
  SUB $G,%EAX
  SHR $3,%EAX
  JMP @mb_edone
mb_ezero:
  XOR %EAX,%EAX
  JMP @mb_edone
mb_ecap:
  MOV [NWD],%EAX
mb_edone:
  MOV [NWD],%EBX           ; EBX = NWD (load)
  CMP %EBX,%EAX
  JBE @mb_eok
  MOV %EBX,%EAX            ; EAX = end_word, clamped
mb_eok:
  MOV [MM_SCR0],%EDX       ; EDX = base_word (load from scratch)
  CMP %EAX,%EDX
  JAE @mb_next
  SUB %EDX,%EAX            ; EAX = nwords
  MOV %EAX,[MM_SCR1]
  ; entry address = MM_BASE + 4 + count*4
  MOV %EDI,%EDX
  SHL $2,%EDX
  ADD $MM_BASE+MM_HDR_WORDS,%EDX
  MOV %EDX,%EAX
  MOV [MM_SCR0],%EBX       ; EBX = base (load)
  MOV $10,%ECX
  CALL @putw
  INC %EAX
  MOV [MM_SCR1],%EBX       ; EBX = nwords (load)
  MOV $10,%ECX
  CALL @putw
  INC %EAX
  MOV [MM_SCR3],%EBX       ; EBX = kind (load)
  MOV $10,%ECX
  CALL @putw
  INC %EAX
  XOR %EBX,%EBX
  MOV $10,%ECX
  CALL @putw
  INC %EDI
mb_next:
  ADD $24,%ESI
  MOV [MM_SCR2],%ECX       ; ECX = saved E820 count (load; putw clobbers it)
  DEC %ECX
  MOV %ECX,[MM_SCR2]       ; store the decremented count
  JNZ @mb_loop
mb_synth:
  TEST %EDI,%EDI
  JNZ @mb_have
  ; no E820 usable/reserved entry: one synthetic range covering NWD words
  MOV $MM_BASE+MM_HDR_WORDS,%EAX
  XOR %EBX,%EBX
  MOV $10,%ECX
  CALL @putw
  INC %EAX
  MOV [NWD],%EBX
  MOV $10,%ECX
  CALL @putw
  INC %EAX
  MOV $MM_K_RAM,%EBX
  MOV $10,%ECX
  CALL @putw
  INC %EAX
  XOR %EBX,%EBX
  MOV $10,%ECX
  CALL @putw
  MOV $1,%EDI
  MOV $MM_F_SYNTH,%EBX
  JMP @mb_hdr
mb_have:
  MOV $MM_F_E820,%EBX
mb_hdr:
  MOV $MM_BASE+3,%EAX
  MOV $10,%ECX
  CALL @putw
  MOV $MM_BASE+1,%EAX
  MOV %EDI,%EBX
  MOV $10,%ECX
  CALL @putw
  POP %EBP
  POP %EDI
  POP %ESI
  POP %EDX
  POP %ECX
  POP %EBX
  RET
