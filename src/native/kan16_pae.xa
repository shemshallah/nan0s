  JMP @fres
h_fdiv:
  TEST $0x7FFFFFFF,%EDX
  JNZ @fd1
  MOV %ECX,%EBX
  AND $0x7FFFFFFF,%EBX
  JZ @fnan
  CMP $0x7F800000,%EBX
  JA @fnan
fd1:
  MOVD %ECX,%XMM0
  MOVD %EDX,%XMM1
  DIVSS %XMM1,%XMM0
fres:
