  TEST $0x80,%EAX
  JNZ @kbrk
  TEST %EBX,%EBX
  JNZ @kext
  CMP $0x2A,%EAX
  JE @kshd
  CMP $0x36,%EAX
  JE @kshd
  CMP $0x3A,%EAX
  JE @kcap
