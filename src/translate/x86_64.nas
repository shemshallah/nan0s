  CALL @x64_store_edx_r
  MOVI r2,0x85
  CALL @x64_8
  MOVI r2,0xD2
  CALL @x64_8
  CALL @x64_flags_z
  SUB r14,r14,r13
  LD r15,r14,0
  RET

; C7 04 25 <XPC> <next>
x64_set_xpc:
  ST r15,r14,0
  ADD r14,r14,r13
  MOVI r2,0xC7
  CALL @x64_8
  MOVI r2,0x04
  CALL @x64_8
  MOVI r2,0x25
  CALL @x64_8
  LA r2,#X64_XPC
  CALL @x64_32
  ADD r2,r7,r0
  CALL @x64_32
  SUB r14,r14,r13
  LD r15,r14,0
  RET

x64_ret:
  MOVI r2,0xC3
  JMP @x64_8

; emit r3 bytes from r2 (LSB first)
x64_emitn:
  ST r15,r14,0
  ADD r14,r14,r13
x64_emitn_loop:
  CMP r3,r0
  JMP[EQ] @x64_emitn_done
  STB r2,r1,0
  SHR r2,r2,8
  ADDI r1,r1,1
  SUB r3,r3,r13
  JMP @x64_emitn_loop
x64_emitn_done:
  SUB r14,r14,r13
  LD r15,r14,0
  RET

; DIV/MOD/DIVU/MODU: r5=d r6=a r8=b r9=opcode.
