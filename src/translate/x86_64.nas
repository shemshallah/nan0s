; BOOL d,a,b with n = predicate nibble.
; r5=d r6=a r8=b r9=n
x64_bool:
  ST r15,r14,0
  ADD r14,r14,r13
  ADD r10,r5,r0
  ADD r5,r6,r0
  CALL @x64_load_eax_r
  ADD r5,r8,r0
  CALL @x64_load_ecx_r
  MOVI r2,0x31
  CALL @x64_8
  MOVI r2,0xFF
  CALL @x64_8
  MOVI r11,1
  BOOL.8 r11,r9,r11
  CMP r11,r0
  JMP[EQ] @x64_bool_t1_skip
  CALL @x64_bool_t1
x64_bool_t1_skip:
  MOVI r11,2
  BOOL.8 r11,r9,r11
  CMP r11,r0
  JMP[EQ] @x64_bool_t2_skip
  CALL @x64_bool_t2
x64_bool_t2_skip:
  MOVI r11,4
  BOOL.8 r11,r9,r11
  CMP r11,r0
  JMP[EQ] @x64_bool_t3_skip
