  CALL @x64_store_edi_r
  MOVI r2,0x85
  CALL @x64_8
  MOVI r2,0xFF
  CALL @x64_8
  CALL @x64_flags_z
  SUB r14,r14,r13
  LD r15,r14,0
  RET

; MUL/MULH/MULHU: r5=d r6=a r8=b; r9 = 0x24 (MUL) or 0x2C (IMUL)
x64_mul_common:
  ST r15,r14,0
  ADD r14,r14,r13
  ADD r10,r5,r0
  ADD r11,r9,r0
  ADD r5,r6,r0
