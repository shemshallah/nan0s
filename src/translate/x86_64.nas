  MOVI r2,0xF7
  CALL @x64_8
  ADD r2,r11,r0
  CALL @x64_8
  MOVI r2,0x25
  CALL @x64_8
  ADD r6,r8,r0
  CALL @x64_addr
  ADD r5,r10,r0
  CALL @x64_store_eax_r
  MOVI r2,0x85
  CALL @x64_8
  MOVI r2,0xC0
  CALL @x64_8
  CALL @x64_flags_z
  SUB r14,r14,r13
  LD r15,r14,0
  RET

x64_mul:
  MOVI r9,0x24
  JMP @x64_mul_common
x64_mulh:
