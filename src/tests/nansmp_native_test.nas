; nansmp_native_test.nas - nansmp CAS/fetch-add/CPU id on a native core.
; Guest word 0x1000 is the atomic target; r14 is a private guest stack.
.org 0
MOVI r14,0xE000
MOVI r1,126
PUTC r1
CALL @nsp_cpu
ADDI r1,r1,48
PUTC r1
MOVI r2,0x1234
ST r2,r0,0x1000
MOVI r1,0x1000
MOVI r2,0x1234
MOVI r3,0x5678
CALL @nsp_cas
MOVI r4,0x1234
CMP r1,r4
MOVI[NE] r1,78
MOVI[EQ] r1,89
PUTC r1
LD r5,r0,0x1000
MOVI r4,0x5678
CMP r5,r4
MOVI[NE] r1,78
MOVI[EQ] r1,89
PUTC r1
MOVI r1,0x1000
MOVI r2,1
CALL @nsp_fetch_add
MOVI r4,0x5678
CMP r1,r4
MOVI[NE] r1,78
MOVI[EQ] r1,89
PUTC r1
LD r5,r0,0x1000
MOVI r4,0x5679
CMP r5,r4
MOVI[NE] r1,78
MOVI[EQ] r1,89
PUTC r1
MOVI r1,10
PUTC r1
MOVI r1,79
PUTC r1
MOVI r1,75
PUTC r1
MOVI r1,10
PUTC r1
HALT
.include "../lib/nansmp.nas"
.org 0x10000
