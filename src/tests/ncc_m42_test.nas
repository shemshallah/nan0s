.str "int main(void){\n wchar_t f1[]={91,37,53,100,93,91,37,45,53,100,93,91,37,48,53,100,93,91,37,43,100,93,91,37,32,100,93,91,37,120,93,91,37,88,93,91,37,111,93,91,37,35,120,93,91,37,35,111,93,10,0};\n wchar_t f2[]={91,37,56,46,51,115,93,91,37,45,56,46,51,115,93,91,37,46,42,115,93,91,37,108,115,93,91,37,54,46,50,108,115,93,10,0};\n wchar_t w[]={119,111,114,108,100,0};\n int n1=wprintf(f1,42,-42,42,42,42,255,255,8,255,8);\n printf(\"|%d\\n\",n1);\n int n2=wprintf(f2,\"abcdef\",\"abcdef\",2,\"abcdef\",w,w);\n printf(\"|%d\\n\",n2);\n return 0;\n}\n"
