; nkv_test.nas - 64-bit zero-copy views + per-agent KV slabs proof (F6).
;
; 1. A 2 TiB storage capability; views at 4 GiB-32, 1 TiB and past 2 TiB.
;    The 4 GiB-straddling view's element 8 is exactly 0x1_00000000.
; 2. KV slab A: 1 GiB page from nheap, node 0, 4 blocks of 2 tokens,
;    append/read/view/regen, 64-bit token addresses, capacity failure.
; 3. KV slab B: 2 MiB page from nheap, node 1, isolated agent/generation.
; A single serial 'O' means all checks passed.
.org 0
JMP @main
.org 0x4000
.include "../lib/nkv.nas"

main:
MOVI r13,1
MOVI r14,0x7000
CALL @nobj_init

; ---------------------------------------------------------------------------
; nheap: node 0 = 8 x 1 GiB at 4 GiB; node 1 = 512 x 2 MiB at 6 GiB
LA r1,@hctx
LA r2,@hdescs
MOVI r3,16
LA r4,@hlists
MOVI r5,12
MOVI r6,4
CALL @nheap_init
LA r1,@hctx
MOVI r2,0
MOVI r3,2
MOVI r4,0
MOVI r5,1
MOVI r6,8
MOVI r7,0
CALL @nheap_add
CMP r1,r0
JMP[NE] @fail
LA r1,@hctx
MOVI r2,1
MOVI r3,1
LA r4,0x80000000
MOVI r5,1
MOVI r6,512
MOVI r7,0
CALL @nheap_add
CMP r1,r0
JMP[NE] @fail

; ---------------------------------------------------------------------------
; 2 TiB storage capability at base 0, read-only
MOVI r1,49
CALL @mark
MOVI r1,0
MOVI r2,0
MOVI r3,0
MOVI r4,512
MOVI r5,1
MOVI r6,0
CALL @nkv_storage_create
CMP r1,r0
JMP[EQ] @fail
LA r7,@cap2t
ST r1,r7,0

; storage metadata unchanged / exact
MOVI r1,50
CALL @mark
LA r1,@cap2t
LD r1,r1,0
LA r2,@sinfo
CALL @nkv_storage_info
CMP r1,r0
JMP[NE] @fail
LA r4,@sinfo
LD r1,r4,0
CMP r1,r0
JMP[NE] @fail
LD r1,r4,1
CMP r1,r0
JMP[NE] @fail
LD r1,r4,2
CMP r1,r0
JMP[NE] @fail
LD r1,r4,3
MOVI r2,512
CMP r1,r2
JMP[NE] @fail

; view V0: the whole 2 TiB as one u8 view (metadata only)
LA r1,@cap2t
LD r1,r1,0
MOVI r2,0
MOVI r3,0
MOVI r4,0
MOVI r5,512
MOVI r6,0
MOVI r7,1
LA r8,@shape1
LA r9,@view0
CALL @nkv_view_create
CMP r1,r0
JMP[NE] @fail
LA r4,@view0
LD r1,r4,6
CMP r1,r0
JMP[NE] @fail
LD r1,r4,7
CMP r1,r0
JMP[NE] @fail
LD r1,r4,8
CMP r1,r0
JMP[NE] @fail
LD r1,r4,9
MOVI r2,512
CMP r1,r2
JMP[NE] @fail
LD r1,r4,10
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,11
CMP r1,r0
JMP[NE] @fail
LD r1,r4,12
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,16
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LA r1,@view0
MOVI r2,0
MOVI r3,0
CALL @nkv_view_addr
CMP r3,r0
JMP[NE] @fail
CMP r1,r0
JMP[NE] @fail
CMP r2,r0
JMP[NE] @fail

; view V1: offset 4 GiB - 32, size 64, f32, rank 1, shape[0]=16
MOVI r1,51
CALL @mark
LA r1,@cap2t
LD r1,r1,0
LA r2,0xFFFFFFE0
MOVI r3,0
MOVI r4,64
MOVI r5,0
MOVI r6,2
MOVI r7,1
LA r8,@shape16
LA r9,@view1
CALL @nkv_view_create
CMP r1,r0
JMP[NE] @fail
LA r4,@view1
LD r1,r4,0
LA r2,#NKV_VIEW_MAGIC
CMP r1,r2
JMP[NE] @fail
LD r1,r4,2
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LD r1,r4,3
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,6
LA r2,0xFFFFFFE0
CMP r1,r2
JMP[NE] @fail
LD r1,r4,7
CMP r1,r0
JMP[NE] @fail
LD r1,r4,8
MOVI r2,64
CMP r1,r2
JMP[NE] @fail
LD r1,r4,9
CMP r1,r0
JMP[NE] @fail
LD r1,r4,10
MOVI r2,16
CMP r1,r2
JMP[NE] @fail
LD r1,r4,11
CMP r1,r0
JMP[NE] @fail
LD r1,r4,12
MOVI r2,16
CMP r1,r2
JMP[NE] @fail
LD r1,r4,16
MOVI r2,4
CMP r1,r2
JMP[NE] @fail
LD r1,r4,17
CMP r1,r0
JMP[NE] @fail

; element 8 is byte offset 32, exactly 4 GiB
LA r1,@view1
MOVI r2,8
MOVI r3,0
CALL @nkv_view_addr
CMP r3,r0
JMP[NE] @fail
CMP r1,r0
JMP[NE] @fail
MOVI r3,1
CMP r2,r3
JMP[NE] @fail
; element 7 is still below 4 GiB
LA r1,@view1
MOVI r2,7
MOVI r3,0
CALL @nkv_view_addr
CMP r3,r0
JMP[NE] @fail
LA r4,0xFFFFFFFC
CMP r1,r4
JMP[NE] @fail
MOVI r4,0
CMP r2,r4
JMP[NE] @fail
; element 16 is out of shape
LA r1,@view1
MOVI r2,16
MOVI r3,0
CALL @nkv_view_addr
LA r2,0xFFFFFFFF
CMP r3,r2
JMP[NE] @fail

; view V2: offset 1 TiB, size 64, element 15 = 1 TiB + 60
MOVI r1,52
CALL @mark
LA r1,@cap2t
LD r1,r1,0
MOVI r2,0
MOVI r3,256
MOVI r4,64
MOVI r5,0
MOVI r6,2
MOVI r7,1
LA r8,@shape16
LA r9,@view2
CALL @nkv_view_create
CMP r1,r0
JMP[NE] @fail
LA r1,@view2
MOVI r2,15
MOVI r3,0
CALL @nkv_view_addr
CMP r3,r0
JMP[NE] @fail
MOVI r4,60
CMP r1,r4
JMP[NE] @fail
MOVI r4,256
CMP r2,r4
JMP[NE] @fail

; view past the 2 TiB end must fail
MOVI r1,53
CALL @mark
LA r1,@cap2t
LD r1,r1,0
LA r2,0xFFFFFFE0
MOVI r3,511
MOVI r4,64
MOVI r5,0
MOVI r6,2
MOVI r7,1
LA r8,@shape16
LA r9,@view3
CALL @nkv_view_create
LA r2,0xFFFFFFFF
CMP r1,r2
JMP[NE] @fail

; ---------------------------------------------------------------------------
; KV slab A: agent 7 gen 1 node 0, f16, 2 layers x 4 heads x 8 dim,
; 256 bytes/token, 8 tokens, 2-token blocks, one 1 GiB page (node 0).
MOVI r1,54
CALL @mark
LA r1,@cfgA
LA r2,@hctx
LA r3,@blockA
MOVI r4,8
CALL @nkv_slab_create
CMP r1,r0
JMP[EQ] @fail
LA r7,@capA
ST r1,r7,0

LA r1,@capA
LD r1,r1,0
LA r2,@sinfo
CALL @nkv_slab_info
CMP r1,r0
JMP[NE] @fail
LA r4,@sinfo
LD r1,r4,0
LA r2,#NKV_SLAB_MAGIC
CMP r1,r2
JMP[NE] @fail
LD r1,r4,2
MOVI r2,7
CMP r1,r2
JMP[NE] @fail
LD r1,r4,3
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,4
CMP r1,r0
JMP[NE] @fail
LD r1,r4,5
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,6
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LD r1,r4,7
MOVI r2,4
CMP r1,r2
JMP[NE] @fail
LD r1,r4,8
MOVI r2,8
CMP r1,r2
JMP[NE] @fail
LD r1,r4,9
MOVI r2,256
CMP r1,r2
JMP[NE] @fail
LD r1,r4,10
CMP r1,r0
JMP[NE] @fail
LD r1,r4,11
MOVI r2,8
CMP r1,r2
JMP[NE] @fail
LD r1,r4,12
CMP r1,r0
JMP[NE] @fail
LD r1,r4,13
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LD r1,r4,14
MOVI r2,4
CMP r1,r2
JMP[NE] @fail
LD r1,r4,15
MOVI r2,8
CMP r1,r2
JMP[NE] @fail
LD r1,r4,16
LA r2,@blockA
CMP r1,r2
JMP[NE] @fail
LD r1,r4,17
CMP r1,r0
JMP[EQ] @fail
LD r1,r4,18
CMP r1,r0
JMP[NE] @fail
LD r1,r4,19
CMP r1,r0
JMP[NE] @fail
LD r1,r4,20
LA r2,0x40000000
CMP r1,r2
JMP[NE] @fail
LD r1,r4,21
CMP r1,r0
JMP[NE] @fail
LD r1,r4,22
MOVI r2,2
CMP r1,r2
JMP[NE] @fail

; base cap is the 1 GiB page at exactly 4 GiB
LA r4,@sinfo
LD r1,r4,17
LA r2,@sinfo2
CALL @nkv_storage_info
CMP r1,r0
JMP[NE] @fail
LA r4,@sinfo2
LD r1,r4,0
CMP r1,r0
JMP[NE] @fail
LD r1,r4,1
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,2
LA r2,0x40000000
CMP r1,r2
JMP[NE] @fail
LD r1,r4,3
CMP r1,r0
JMP[NE] @fail

; block table: {0,2,0}, {2,2,512}, {4,2,1024}, {6,2,1536}
LA r6,@blockA
LD r1,r6,0
CMP r1,r0
JMP[NE] @fail
LD r1,r6,1
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LD r1,r6,2
CMP r1,r0
JMP[NE] @fail
LD r1,r6,3
CMP r1,r0
JMP[NE] @fail
LD r1,r6,8
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LD r1,r6,10
MOVI r2,512
CMP r1,r2
JMP[NE] @fail
LD r1,r6,16
MOVI r2,4
CMP r1,r2
JMP[NE] @fail
LD r1,r6,18
MOVI r2,1024
CMP r1,r2
JMP[NE] @fail
LD r1,r6,24
MOVI r2,6
CMP r1,r2
JMP[NE] @fail
LD r1,r6,26
MOVI r2,1536
CMP r1,r2
JMP[NE] @fail

; append 1 + 7 = 8 tokens, then capacity fails
MOVI r1,55
CALL @mark
LA r1,@capA
LD r1,r1,0
CALL @nkv_slab_append
CMP r1,r0
JMP[NE] @fail
LA r1,@capA
LD r1,r1,0
MOVI r2,7
CALL @nkv_slab_append_n
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LA r1,@capA
LD r1,r1,0
CALL @nkv_slab_used
MOVI r2,8
CMP r1,r2
JMP[NE] @fail
LA r1,@capA
LD r1,r1,0
CALL @nkv_slab_capacity
MOVI r2,8
CMP r1,r2
JMP[NE] @fail
LA r1,@capA
LD r1,r1,0
CALL @nkv_slab_append
LA r2,0xFFFFFFFF
CMP r1,r2
JMP[NE] @fail
LA r1,@capA
LD r1,r1,0
MOVI r2,1
CALL @nkv_slab_append_n
LA r2,0xFFFFFFFF
CMP r1,r2
JMP[NE] @fail

; token 2 address: 4 GiB + 512, length 256
MOVI r1,56
CALL @mark
LA r1,@capA
LD r1,r1,0
MOVI r2,2
LA r3,@rout
CALL @nkv_slab_read_token
CMP r1,r0
JMP[NE] @fail
LA r6,@rout
LD r1,r6,0
MOVI r2,512
CMP r1,r2
JMP[NE] @fail
LD r1,r6,1
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r6,2
MOVI r2,256
CMP r1,r2
JMP[NE] @fail
LD r1,r6,3
CMP r1,r0
JMP[NE] @fail
LD r1,r6,5
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r6,6
MOVI r2,7
CMP r1,r2
JMP[NE] @fail
LD r1,r6,7
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LA r4,@sinfo
LD r1,r6,4
LD r2,r4,17
CMP r1,r2
JMP[NE] @fail

; token 7 address: 4 GiB + 1792
MOVI r1,57
CALL @mark
LA r1,@capA
LD r1,r1,0
MOVI r2,7
MOVI r3,0
CALL @nkv_slab_token_addr
CMP r5,r0
JMP[NE] @fail
MOVI r6,0x700
CMP r1,r6
JMP[NE] @fail
MOVI r6,1
CMP r2,r6
JMP[NE] @fail
MOVI r6,0x100
CMP r3,r6
JMP[NE] @fail

; token 8 is not appended
LA r1,@capA
LD r1,r1,0
MOVI r2,8
LA r3,@rout
CALL @nkv_slab_read_token
LA r2,0xFFFFFFFF
CMP r1,r2
JMP[NE] @fail

; token view: 256 bytes, 128 f16 elements, offset 512
MOVI r1,58
CALL @mark
LA r1,@capA
LD r1,r1,0
MOVI r2,2
LA r3,@viewA2
CALL @nkv_slab_token_view
CMP r1,r0
JMP[NE] @fail
LA r4,@viewA2
LD r1,r4,2
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,3
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,6
MOVI r2,512
CMP r1,r2
JMP[NE] @fail
LD r1,r4,7
CMP r1,r0
JMP[NE] @fail
LD r1,r4,8
MOVI r2,256
CMP r1,r2
JMP[NE] @fail
LD r1,r4,10
MOVI r2,128
CMP r1,r2
JMP[NE] @fail
LD r1,r4,11
CMP r1,r0
JMP[NE] @fail
LD r1,r4,12
MOVI r2,128
CMP r1,r2
JMP[NE] @fail
LD r1,r4,16
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LD r1,r4,17
CMP r1,r0
JMP[NE] @fail
LD r1,r4,22
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,23
LA r2,@capA
LD r2,r2,0
CMP r1,r2
JMP[NE] @fail

; view element 64 -> 4 GiB + 640
LA r1,@viewA2
MOVI r2,64
MOVI r3,0
CALL @nkv_view_addr
CMP r3,r0
JMP[NE] @fail
MOVI r4,0x280
CMP r1,r4
JMP[NE] @fail
MOVI r4,1
CMP r2,r4
JMP[NE] @fail

; generation 1 is valid
LA r1,@viewA2
LA r2,@capA
LD r2,r2,0
CALL @nkv_view_check
MOVI r2,1
CMP r1,r2
JMP[NE] @fail

; regen -> 2 invalidates the old token view
MOVI r1,59
CALL @mark
LA r1,@capA
LD r1,r1,0
CALL @nkv_slab_regen
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LA r1,@viewA2
LA r2,@capA
LD r2,r2,0
CALL @nkv_view_check
CMP r1,r0
JMP[NE] @fail
LA r1,@capA
LD r1,r1,0
CALL @nkv_slab_used
MOVI r2,8
CMP r1,r2
JMP[NE] @fail
LA r1,@capA
LD r1,r1,0
MOVI r2,2
LA r3,@viewA2b
CALL @nkv_slab_token_view
CMP r1,r0
JMP[NE] @fail
LA r1,@viewA2b
LA r2,@capA
LD r2,r2,0
CALL @nkv_view_check
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LA r4,@viewA2b
LD r1,r4,22
MOVI r2,2
CMP r1,r2
JMP[NE] @fail

; ---------------------------------------------------------------------------
; KV slab B: agent 9 gen 5 node 1, 64 bytes/token, 4 tokens,
; 1-token blocks, one 2 MiB page at 6 GiB.
MOVI r1,65
CALL @mark
LA r1,@cfgB
LA r2,@hctx
LA r3,@blockB
MOVI r4,8
CALL @nkv_slab_create
CMP r1,r0
JMP[EQ] @fail
LA r7,@capB
ST r1,r7,0

LA r1,@capB
LD r1,r1,0
LA r2,@sinfo
CALL @nkv_slab_info
CMP r1,r0
JMP[NE] @fail
LA r4,@sinfo
LD r1,r4,2
MOVI r2,9
CMP r1,r2
JMP[NE] @fail
LD r1,r4,3
MOVI r2,5
CMP r1,r2
JMP[NE] @fail
LD r1,r4,4
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,9
MOVI r2,64
CMP r1,r2
JMP[NE] @fail
LD r1,r4,11
MOVI r2,4
CMP r1,r2
JMP[NE] @fail
LD r1,r4,13
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,14
MOVI r2,4
CMP r1,r2
JMP[NE] @fail
LD r1,r4,20
LA r2,0x200000
CMP r1,r2
JMP[NE] @fail
LD r1,r4,21
CMP r1,r0
JMP[NE] @fail
LD r1,r4,22
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,17
LA r2,@sinfo2
CALL @nkv_storage_info
CMP r1,r0
JMP[NE] @fail
LA r4,@sinfo2
LD r1,r4,0
LA r2,0x80000000
CMP r1,r2
JMP[NE] @fail
LD r1,r4,1
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r4,2
LA r2,0x200000
CMP r1,r2
JMP[NE] @fail
LD r1,r4,3
CMP r1,r0
JMP[NE] @fail

; block table: 0/64/128/192
LA r6,@blockB
LD r1,r6,2
CMP r1,r0
JMP[NE] @fail
LD r1,r6,10
MOVI r2,64
CMP r1,r2
JMP[NE] @fail
LD r1,r6,18
MOVI r2,128
CMP r1,r2
JMP[NE] @fail
LD r1,r6,26
MOVI r2,192
CMP r1,r2
JMP[NE] @fail

; append 2, read token 1 = 6 GiB + 64
MOVI r1,66
CALL @mark
LA r1,@capB
LD r1,r1,0
MOVI r2,2
CALL @nkv_slab_append_n
CMP r1,r0
JMP[NE] @fail
LA r1,@capB
LD r1,r1,0
MOVI r2,1
LA r3,@rout
CALL @nkv_slab_read_token
CMP r1,r0
JMP[NE] @fail
LA r6,@rout
LD r1,r6,0
LA r2,0x80000040
CMP r1,r2
JMP[NE] @fail
LD r1,r6,1
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LD r1,r6,2
MOVI r2,64
CMP r1,r2
JMP[NE] @fail
LD r1,r6,5
MOVI r2,5
CMP r1,r2
JMP[NE] @fail
LD r1,r6,6
MOVI r2,9
CMP r1,r2
JMP[NE] @fail
; token 2 is not appended yet
LA r1,@capB
LD r1,r1,0
MOVI r2,2
LA r3,@rout
CALL @nkv_slab_read_token
LA r2,0xFFFFFFFF
CMP r1,r2
JMP[NE] @fail

; isolation: A unchanged at 8 used, gen 2; B at 2 used
MOVI r1,67
CALL @mark
LA r1,@capA
LD r1,r1,0
CALL @nkv_slab_used
MOVI r2,8
CMP r1,r2
JMP[NE] @fail
LA r1,@capB
LD r1,r1,0
CALL @nkv_slab_used
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LA r1,@capB
LD r1,r1,0
CALL @nkv_slab_regen
MOVI r2,6
CMP r1,r2
JMP[NE] @fail
LA r1,@capA
LD r1,r1,0
LA r2,@sinfo
CALL @nkv_slab_info
CMP r1,r0
JMP[NE] @fail
LA r4,@sinfo
LD r1,r4,3
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LD r1,r4,12
MOVI r2,8
CMP r1,r2
JMP[NE] @fail

; token view B at gen 6; cross-owner checks fail
MOVI r1,68
CALL @mark
LA r1,@capB
LD r1,r1,0
MOVI r2,1
LA r3,@viewB1
CALL @nkv_slab_token_view
CMP r1,r0
JMP[NE] @fail
LA r4,@viewB1
LD r1,r4,22
MOVI r2,6
CMP r1,r2
JMP[NE] @fail
LA r1,@viewB1
LA r2,@capB
LD r2,r2,0
CALL @nkv_view_check
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LA r1,@viewB1
LA r2,@capA
LD r2,r2,0
CALL @nkv_view_check
CMP r1,r0
JMP[NE] @fail
LA r1,@viewA2b
LA r2,@capB
LD r2,r2,0
CALL @nkv_view_check
CMP r1,r0
JMP[NE] @fail

; fill B to capacity 4, 5th fails; A still 8
MOVI r1,69
CALL @mark
LA r1,@capB
LD r1,r1,0
MOVI r2,2
CALL @nkv_slab_append_n
MOVI r2,2
CMP r1,r2
JMP[NE] @fail
LA r1,@capB
LD r1,r1,0
CALL @nkv_slab_append
LA r2,0xFFFFFFFF
CMP r1,r2
JMP[NE] @fail
LA r1,@capA
LD r1,r1,0
CALL @nkv_slab_used
MOVI r2,8
CMP r1,r2
JMP[NE] @fail

; backing came from nheap: node 0 has 7 x 1 GiB left, node 1 511 x 2 MiB
MOVI r1,74
CALL @mark
LA r1,@hctx
MOVI r2,0
MOVI r3,2
LA r4,@stats
CALL @nheap_stats
CMP r1,r0
JMP[NE] @fail
LA r4,@stats
LD r1,r4,0
MOVI r2,7
CMP r1,r2
JMP[NE] @fail
LD r1,r4,2
MOVI r2,1
CMP r1,r2
JMP[NE] @fail
LA r1,@hctx
MOVI r2,1
MOVI r3,1
LA r4,@stats
CALL @nheap_stats
CMP r1,r0
JMP[NE] @fail
LA r4,@stats
LD r1,r4,0
MOVI r2,511
CMP r1,r2
JMP[NE] @fail
LD r1,r4,2
MOVI r2,1
CMP r1,r2
JMP[NE] @fail

; slab A and B are distinct agents, caps, nodes and bases
LA r7,@capA
LD r7,r7,0
LA r8,@capB
LD r8,r8,0
CMP r7,r8
JMP[EQ] @fail

MOVI r1,79
PUTC r1
HALT

fail:
LA r2,@stage
LD r1,r2,0
PUTC r1
MOVI r1,70
PUTC r1
HALT

mark:
LA r2,@stage
ST r1,r2,0
RET

