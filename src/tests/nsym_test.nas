; nsym_test.nas - symbiotic multi-agent scheduling proof (F13f).
;
; 3 weighted agents (1,2,3) share one immutable weight root and run three
; 20-tick fairness rounds on 2 CPUs; the ratio bound |s_i*W - w_i*S| <= W is
; checked at each round.  Agent 1 then publishes generation 2 onto a second
; root while agents 2/3 keep admitted jobs on root 0/generation 1, drains
; generation 2, starts generation 3, and agent 3 still admits on generation 1.
; Agents 4/5/6 exercise a deadline reservation (6 reserved ticks by tick+6)
; on a third weighted set.  Agents 7/8 exercise mid-job budget enforcement and
; a stale-budget admission, then agent 4 takes a missed deadline.  Finally all
; agents leave in an order that proves the root refcount stays live at one
; reference and is freed exactly at zero; the freed root rejects acquire and
; verify.  Every status word, root record, agent record and the last eight
; trace entries are snapshotted and the whole scenario is replayed from a cold
; init; the two 1184-word snapshots must match word-for-word.
;
; Success prints exactly O.  Failure prints F<actual>,<expected>,<diag>.

.equ NSNAP   1184

.org 0
JMP @main
.include "../lib/nsym.nas"

main:
MOVI r13,1
LA r14,@stack

; ---- run 1
CALL @nsym_init
CALL @scenario
LA r1,@snapA
CALL @snapshot

; ---- run 2 (cold init, identical scenario)
CALL @nsym_init
CALL @scenario
LA r1,@snapB
CALL @snapshot

LA r1,@snapA
LA r2,@snapB
MOVI r3,#NSNAP
CALL @cmpbuf
MOVI r2,0
MOVI r3,399
CALL @chk

MOVI r1,79
PUTC r1
HALT

; ---------------------------------------------------------------------------
