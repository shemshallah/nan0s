; scenario helpers.
qg:
LA r1,@stG
JMP @nsym_global
qr0:
MOVI r1,0
LA r2,@stR0
JMP @nsym_root_status
qr1:
MOVI r1,1
LA r2,@stR1
JMP @nsym_root_status
qs1:
MOVI r1,1
LA r2,@st1
JMP @nsym_agent_status
qs2:
MOVI r1,2
LA r2,@st2
JMP @nsym_agent_status
qs3:
MOVI r1,3
LA r2,@st3
JMP @nsym_agent_status
qs4:
MOVI r1,4
LA r2,@st4
JMP @nsym_agent_status
qs5:
MOVI r1,5
LA r2,@st5
JMP @nsym_agent_status
qs6:
MOVI r1,6
LA r2,@st6
JMP @nsym_agent_status
qs7:
MOVI r1,7
LA r2,@st7
JMP @nsym_agent_status
qs8:
MOVI r1,8
LA r2,@st8
JMP @nsym_agent_status
q1:
JMP @qs1
q2:
JMP @qs2
q3:
JMP @qs3

; qng r1=agent -> ngen_status into ngbuf.
qng:
LA r2,@ngbuf
JMP @ngen_status

; saver0/saver1: copy the live root record to a saved buffer.
saver0:
LA r1,@stR0
LA r2,@savR0
MOVI r3,32
BCOPY r2,r1,r3
MOVI r1,0
RET
saver1:
LA r1,@stR1
LA r2,@savR1
MOVI r3,32
BCOPY r2,r1,r3
MOVI r1,0
RET

; rootr0same/rootr1same: live root payload and hash still equal the saved copy.
rootr0same:
ST r15,r14,0
ADDI r14,r14,16
CALL @qr0
LA r1,@stR0
ADDI r1,r1,#NS_R_HASH
LA r2,@savR0
ADDI r2,r2,#NS_R_HASH
MOVI r3,1
CALL @cmpbuf
CMP r1,r0
JMP[NE] @rrs_bad
LA r1,@stR0
ADDI r1,r1,#NS_R_PAYLOAD
LA r2,@savR0
ADDI r2,r2,#NS_R_PAYLOAD
MOVI r3,16
CALL @cmpbuf
JMP @rrs_out
rrs_bad:
MOVI r1,1
rrs_out:
ADDI r14,r14,-16
LD r15,r14,0
RET
rootr1same:
ST r15,r14,0
ADDI r14,r14,16
CALL @qr1
LA r1,@stR1
ADDI r1,r1,#NS_R_HASH
LA r2,@savR1
ADDI r2,r2,#NS_R_HASH
MOVI r3,1
CALL @cmpbuf
CMP r1,r0
JMP[NE] @r1s_bad
LA r1,@stR1
ADDI r1,r1,#NS_R_PAYLOAD
LA r2,@savR1
ADDI r2,r2,#NS_R_PAYLOAD
MOVI r3,16
CALL @cmpbuf
JMP @r1s_out
r1s_bad:
MOVI r1,1
r1s_out:
ADDI r14,r14,-16
LD r15,r14,0
RET

; ratio r1=diag base: check |s_i*W - w_i*S| <= W for agents 1,2,3.
ratio:
ST r15,r14,0
ADDI r14,r14,64
ST r1,r14,1
; served values and S
LD r2,r14,1
ST r2,r14,2
LA r1,@st1
LD r2,r1,#NS_A_SERVED
ST r2,r14,3
LA r1,@st2
LD r2,r1,#NS_A_SERVED
ST r2,r14,4
LA r1,@st3
LD r2,r1,#NS_A_SERVED
ST r2,r14,5
LA r1,@stG
LD r2,r1,#NS_G_SERVICE
ST r2,r14,6
; A: s1*6 - 1*S
LD r1,r14,3
MOVI r2,6
MUL r1,r1,r2
LD r3,r14,6
SUB r1,r1,r3
CALL @abs
MOVI r2,6
LD r3,r14,1
CALL @chkle
; B: s2*6 - 2*S
LD r1,r14,4
MOVI r2,6
MUL r1,r1,r2
LD r3,r14,6
ADD r3,r3,r3
SUB r1,r1,r3
CALL @abs
MOVI r2,6
LD r3,r14,1
ADDI r3,r3,1
CALL @chkle
; C: s3*6 - 3*S
LD r1,r14,5
MOVI r2,6
MUL r1,r1,r2
LD r3,r14,6
MOVI r2,3
MUL r3,r3,r2
SUB r1,r1,r3
CALL @abs
MOVI r2,6
LD r3,r14,1
ADDI r3,r3,2
CALL @chkle
ADDI r14,r14,-64
LD r15,r14,0
RET

abs:
CMPS r1,r0
JMP[GE] @abs_out
SUB r1,r0,r1
abs_out:
RET


; ---------------------------------------------------------------------------
; Check helpers.  chkst is the single implementation; the rest are thin
; base-pointer wrappers so the scenario reads as field checks.
; chkst r1=base r2=offset r3=expected r4=diag.
chkst:
ST r15,r14,0
ADDI r14,r14,32
ST r1,r14,1
ST r2,r14,2
ST r3,r14,3
ST r4,r14,4
LD r1,r14,1
LD r2,r14,2
ADD r1,r1,r2
LD r1,r1,0
LD r2,r14,3
LD r3,r14,4
CALL @chk
ADDI r14,r14,-32
LD r15,r14,0
RET

; chkg r2=off r3=exp r4=diag.
chkg:
ST r15,r14,0
ADDI r14,r14,32
ST r2,r14,1
ST r3,r14,2
ST r4,r14,3
LA r1,@stG
LD r2,r14,1
LD r3,r14,2
LD r4,r14,3
CALL @chkst
ADDI r14,r14,-32
LD r15,r14,0
RET

; chkr0/chkr1 wrappers.
chkr0:
ST r15,r14,0
ADDI r14,r14,32
ST r2,r14,1
ST r3,r14,2
ST r4,r14,3
LA r1,@stR0
LD r2,r14,1
LD r3,r14,2
LD r4,r14,3
CALL @chkst
