ADDI r14,r14,32
ST r2,r14,1
ST r3,r14,2
ST r4,r14,3
LA r1,@ngbuf
LD r2,r14,1
LD r3,r14,2
LD r4,r14,3
CALL @chkst
ADDI r14,r14,-32
LD r15,r14,0
RET

; chkt r2=off r3=exp r4=diag for the trace entry buffer.
chkt:
ST r15,r14,0
ADDI r14,r14,32
ST r2,r14,1
ST r3,r14,2
ST r4,r14,3
LA r1,@tbuf
LD r2,r14,1
LD r3,r14,2
LD r4,r14,3
CALL @chkst
ADDI r14,r14,-32
LD r15,r14,0
RET

; chkerr r1=expected r2=diag.
chkerr:
ST r15,r14,0
ADDI r14,r14,16
ST r1,r14,1
ST r2,r14,2
CALL @nsym_errno
LD r2,r14,1
LD r3,r14,2
CALL @chk
ADDI r14,r14,-16
LD r15,r14,0
RET

; chk r1=actual r2=expected r3=diag.  Failure prints F=actual,expected,diag.
chk:
CMP r1,r2
JMP[EQ] @chk_ok
ST r15,r14,0
ADDI r14,r14,24
ST r1,r14,1
ST r2,r14,2
ST r3,r14,3
MOVI r1,70
PUTC r1
MOVI r1,61
PUTC r1
LD r1,r14,1
CALL @putdec3
MOVI r1,44
PUTC r1
LD r1,r14,2
CALL @putdec3
MOVI r1,44
PUTC r1
LD r1,r14,3
CALL @putdec3
MOVI r1,10
PUTC r1
HALT
chk_ok:
MOVI r1,0
RET

; chkle r1=value r2=bound r3=diag: fail unless value <= bound.
chkle:
CMP r1,r2
JMP[LE] @chkle_ok
ST r15,r14,0
ADDI r14,r14,24
ST r1,r14,1
ST r2,r14,2
ST r3,r14,3
MOVI r1,70
PUTC r1
MOVI r1,61
PUTC r1
LD r1,r14,1
CALL @putdec3
MOVI r1,44
PUTC r1
LD r1,r14,2
CALL @putdec3
MOVI r1,44
PUTC r1
LD r1,r14,3
CALL @putdec3
MOVI r1,10
PUTC r1
HALT
chkle_ok:
MOVI r1,0
RET

; putdec3 r1=0..999 -> three decimal digits.
putdec3:
ST r15,r14,0
ADDI r14,r14,16
ST r1,r14,1
MOVI r2,100
DIVU r3,r1,r2
MOVI r4,48
ADD r3,r3,r4
PUTC r3
LD r1,r14,1
MOVI r2,100
MODU r1,r1,r2
MOVI r2,10
DIVU r3,r1,r2
ADD r3,r3,r4
PUTC r3
MODU r1,r1,r2
ADD r1,r1,r4
PUTC r1
ADDI r14,r14,-16
LD r15,r14,0
RET

; cmpbuf r1=a r2=b r3=words -> 0 equal / 1 different.
cmpbuf:
cmpl:
CMP r3,r0
JMP[EQ] @cmp_ok
LD r4,r1,0
LD r5,r2,0
CMP r4,r5
JMP[NE] @cmp_bad
ADD r1,r1,r13
ADD r2,r2,r13
SUB r3,r3,r13
JMP @cmpl
cmp_bad:
MOVI r1,1
RET
cmp_ok:
MOVI r1,0
RET

; ---------------------------------------------------------------------------
; snapshot r1=out(1184): global 32, roots 0/1 64, agents 1..8 1024,
; last eight trace entries 64.
snapshot:
ST r15,r14,0
ADDI r14,r14,64
ST r1,r14,1
CALL @nsym_global
MOVI r1,0
LD r2,r14,1
ADDI r2,r2,32
CALL @nsym_root_status
MOVI r1,1
LD r2,r14,1
ADDI r2,r2,64
CALL @nsym_root_status
MOVI r2,1
ST r2,r14,2
sn_agents:
LD r2,r14,2
MOVI r3,8
CMP r2,r3
JMP[GT] @sn_trace
LD r3,r14,2
SUB r3,r3,r13
SHL r3,r3,7
ADDI r3,r3,96
LD r4,r14,1
ADD r4,r4,r3
MOVI r1,0
ADD r1,r2,r0
ADD r2,r4,r0
CALL @nsym_agent_status
LD r2,r14,2
ADDI r2,r2,1
ST r2,r14,2
JMP @sn_agents
sn_trace:
LD r1,r14,1
LD r2,r1,#NS_G_TRN
ST r2,r14,3
MOVI r3,8
SUB r2,r2,r3
ST r2,r14,4
ST r0,r14,5
sn_tl:
LD r2,r14,5
MOVI r3,8
CMP r2,r3
JMP[GE] @sn_done
LD r1,r14,4
ADD r1,r1,r2
LD r3,r14,5
SHL r3,r3,3
ADDI r3,r3,1120
LD r4,r14,1
ADD r2,r4,r3
CALL @nsym_trace
LD r2,r14,5
ADDI r2,r2,1
ST r2,r14,5
JMP @sn_tl
sn_done:
ADDI r14,r14,-64
LD r15,r14,0
RET

