; vec512_native_test.nas - native x86 lowering of VZERO/VBCAST/VDP4B/VGET/VSET.
.org 0
JMP @main
main:
MOVI r13,1
VZERO r0
LA r1,0x04030201
VBCAST r1,r1
LA r1,0x08070605
VBCAST r2,r1
VDP4B r3,r1,r2
VGET r4,r3,0
ADD r3,r4,r0
CALL @ph
VGET r4,r3,15
ADD r3,r4,r0
CALL @ph
LA r1,0xDEADBEEF
VSET r5,r1,7
VGET r3,r5,7
CALL @ph
VZERO r6
VGET r3,r6,0
CALL @ph
LA r1,0x01010101
VBCAST r1,r1
VADD8 r2,r1,r1
VGET r3,r2,0
CALL @ph
VSUB8 r2,r1,r1
VGET r3,r2,0
CALL @ph
VADD32 r2,r1,r1
VGET r3,r2,0
CALL @ph
VSUB32 r2,r1,r1
VGET r3,r2,0
CALL @ph
LA r1,0x00010001
VBCAST r1,r1
VMUL32 r2,r1,r1
VGET r3,r2,0
CALL @ph
LA r1,@s_pass
CALL @puts
HALT
ph:
MOVI r9,8
ph1:
SHR r5,r3,28
SHL r3,r3,4
MOVI r6,10
CMP r5,r6
MOVI r7,48
MOVI[GE] r7,55
ADD r7,r7,r5
PUTC r7
SUB r9,r9,r13
CMP r9,r0
JMP[NE] @ph1
MOVI r7,10
PUTC r7
RET
puts:
SHL r1,r1,2
pl:
LDB r2,r1,0
CMP r2,r0
JMP[EQ] @pd
PUTC r2
ADDI r1,r1,1
JMP @pl
pd:
RET
s_pass:
.str "VECN PASS\n"
