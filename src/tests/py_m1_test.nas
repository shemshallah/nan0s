.org 0
JMP @main
.include "../lib/ncc.nas"
main:
MOVI r13,1
LA r1,@c_src
CALL @ncc_compile
CALL @ncc_run
HALT
c_src:
.str "char src[2048];\nint pos;\nchar names[16][16];\ndouble vals[16];\nint nvars;\n\nvoid skipsp(void){ while(src[pos]==' '||src[pos]=='\\t') pos++; }\nint isidc(int c){ return isalpha(c)||isdigit(c)||c=='_'; }\nint getid(char *b){ int n=0; skipsp(); while(isidc(src[pos])){ if(n<15){ b[n]=src[pos]; n++; } pos++; } b[n]=0; return n; }\nint find(char *b){ int i; for(i=0;i<nvars;i++){ if(strcmp(names[i],b)==0) return i; } return -1; }\nvoid setv(char *b,double v){ int i=find(b); if(i<0){ i=nvars; nvars++; strcpy(names[i],b); } vals[i]=v; }\ndouble expr(void);\ndouble primary(void){\n  double v; char *e; char b[16]; int i;\n  skipsp();\n  if(src[pos]=='-'){ pos++; return -primary(); }\n  if(src[pos]=='('){ pos++; v=expr(); skipsp(); if(src[pos]==')') pos++; return v; }\n  if(isdigit(src[pos])||src[pos]=='.'){ v=strtod(src+pos,&e); pos=e-src; return v; }\n  if(isalpha(src[pos])||src[pos]=='_'){ getid(b); i=find(b); if(i<0) return 0; return vals[i]; }\n  return 0;\n}\ndouble term(void){ double v=primary(); while(1){ skipsp(); if(src[pos]=='*'){ pos++; v=v*primary(); } else if(src[pos]=='/'){ pos++; v=v/primary(); } else return v; } }\ndouble sexpr(void){ double v=term(); while(1){ skipsp(); if(src[pos]=='+'){ pos++; v=v+term(); } else if(src[pos]=='-'){ pos++; v=v-term(); } else return v; } }\ndouble cmp(void){\n  double v=sexpr(); skipsp();\n  if(src[pos]=='<'){ pos++; if(src[pos]=='='){ pos++; return v<=sexpr(); } return v<sexpr(); }\n  if(src[pos]=='>'){ pos++; if(src[pos]=='='){ pos++; return v>=sexpr(); } return v>sexpr(); }\n  if(src[pos]=='='&&src[pos+1]=='='){ pos+=2; return v==sexpr(); }\n  if(src[pos]=='!'&&src[pos+1]=='='){ pos+=2; return v!=sexpr(); }\n  return v;\n}\ndouble expr(void){ return cmp(); }\nvoid skipnl(void){ while(src[pos]=='\\n'||src[pos]==' '||src[pos]=='\\t') pos++; }\nvoid pstr(void){ pos++; while(src[pos]&&src[pos]!='\"'){ if(src[pos]=='\\\\'&&src[pos+1]=='n'){ putchar('\\n'); pos+=2; } else { putchar(src[pos]); pos++; } } if(src[pos]=='\"') pos++; }\nvoid stmt(void){\n  char b[16];\n  skipsp();\n  if(src[pos]==0||src[pos]=='\\n'||src[pos]==';'||src[pos]=='#') return;\n  if(!getid(b)){ pos++; return; }\n  skipsp();\n  if(src[pos]=='='&&src[pos+1]!='='){ pos++; setv(b,expr()); return; }\n  if(strcmp(b,\"print\")==0){\n    if(src[pos]=='(') pos++;\n    while(1){ skipsp(); if(src[pos]=='\"'){ pstr(); } else { printf(\"%g\",expr()); } skipsp(); if(src[pos]==','){ pos++; printf(\" \"); continue; } break; }\n    if(src[pos]==')') pos++;\n    putchar('\\n');\n    return;\n  }\n  if(strcmp(b,\"if\")==0){\n    double c=expr(); skipsp(); if(src[pos]==':') pos++;\n    if(c){ skipnl(); stmt(); }\n    else { while(src[pos]&&src[pos]!='\\n') pos++; if(src[pos]=='\\n') pos++; while(src[pos]==' '||src[pos]=='\\t') pos++; while(src[pos]&&src[pos]!='\\n') pos++; }\n    return;\n  }\n  if(strcmp(b,\"pass\")==0) return;\n}\nint main(void){\n  strcpy(src,\"x = 2\\ny = 3\\nprint(\\\"x+y =\\\", x + y)\\nprint((x + y) * 4 / 2)\\nprint(1 + 2 * 3)\\nif x < y:\\n print(\\\"yes\\\")\\nif x > y:\\n print(\\\"no\\\")\\nz = -x + 10\\nprint(z)\\nx = x * 5\\nprint(x)\\nprint(\\\"done\\\")\\n\");\n  pos=0; nvars=0;\n  while(src[pos]){\n    stmt();\n    while(src[pos]==' '||src[pos]=='\\t') pos++;\n    if(src[pos]=='\\n'||src[pos]==';') pos++;\n  }\n  return 0;\n}\n"
